{
  "name": "serverloom",
  "version": "0.10.0-alpha.3",
  "description": "AI-assisted desktop server operations with SSH, SFTP and local scheduling",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "runtime:bundle": "node scripts/bundle-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.cjs",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "brand:render": "electron scripts/render-logo.cjs",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "dist": "npm run build && node scripts/build-release.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "15.0.2",
    "semver": "7.8.5",
    "ssh2": "1.17.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.55.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "dev.serverloom.desktop",
    "productName": "ServerLoom",
    "beforePack": "./scripts/verify-bundle.cjs",
    "directories": {
      "output": "release-update"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "resources/branding/**/*",
      "LICENSE",
      "resources/third-party/**/*",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/build/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/branding/servers.ico"
    },
    "artifactName": "ServerLoom-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "CrxzyChen",
        "repo": "serverloom",
        "releaseType": "draft"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ServerLoom-Setup-${version}-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "author": "ServerLoom contributors"
}
